# =============================================================================
# Ainer Boot 开发环境配置模板
# =============================================================================
# 用法：
#   cp .env.example .env
#   # 按需修改密码与路径
#
# 安全：本文件只包含占位符，不含真实密钥。
#   .env 被 .gitignore 忽略（!.env.example 白名单例外），修改 .env 不会被提交。
#
# 完整本地环境启动见 docs/development.md §3 "Docker Compose 快速启动"。

# ---- PostgreSQL 超级用户（用于初始化双库双用户）----
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me

# ---- 业务数据库（ainer-server 专用）----
AINER_DB_PASSWORD=change-me

# ---- Authorization Server 数据库（与业务库隔离）----
AINER_AUTH_DB_PASSWORD=change-me

# ---- Authorization Server 配置 ----
# 端口（宿主机映射）
AINER_AUTHORIZATION_SERVER_PORT=9000
# issuer 必须是显式 https:// URL（代码 AinerAuthorizationServerConfiguration:96 强制校验）
AINER_AUTHORIZATION_SERVER_ISSUER=https://localhost:9000
AINER_AUTHORIZATION_SERVER_AUDIENCE=ainer-api
# RSA 3072 签名密钥（bash scripts/generate-dev-keys.sh 生成）
AINER_AUTHORIZATION_SIGNING_KEY_ID=ainer-dev-1
AINER_AUTHORIZATION_PRIVATE_KEY_LOCATION=file:/etc/ainer/dev-keys/private.pem
AINER_AUTHORIZATION_PUBLIC_KEY_LOCATION=file:/etc/ainer/dev-keys/public.pem

# ---- Ainer Admin 开发夹具（首次初始化创建测试身份，稳定后建议关闭）----
AINER_ADMIN_DEV_BOOTSTRAP_ENABLED=true
AINER_ADMIN_DEV_OWNER_USERNAME=owner@ainer-dev.test
AINER_ADMIN_DEV_OWNER_PASSWORD=change-me
AINER_ADMIN_DEV_OWNER_DISPLAY_NAME=Dev Owner
AINER_ADMIN_DEV_MEMBER_USERNAME=member@ainer-dev.test
AINER_ADMIN_DEV_MEMBER_PASSWORD=change-me
AINER_ADMIN_DEV_MEMBER_DISPLAY_NAME=Dev Member

# ---- 业务 Resource Server（ainer-server）----
AINER_SECURITY_ISSUER_URI=https://localhost:9000
AINER_SECURITY_AUDIENCES=ainer-api

# ---- 可选能力开关（默认关闭，按需开启）----
AINER_AI_ENABLED=false
AINER_WORKSPACE_ENABLED=true
AINER_SECURITY_RESOURCE_SERVER_ENABLED=true
