<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.ainer</groupId>
    <artifactId>ainer-dependencies</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>Ainer Dependencies</name>
    <description>Version alignment for Ainer Boot framework, starters and modules</description>
    <url>https://github.com/ainerlab/ainer-boot</url>

    <scm>
        <connection>scm:git:https://github.com/ainerlab/ainer-boot.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/ainerlab/ainer-boot.git</developerConnection>
        <tag>HEAD</tag>
        <url>https://github.com/ainerlab/ainer-boot</url>
    </scm>

    <!-- The BOM is deliberately parentless so the root project can import it without a model cycle. -->
    <properties>
        <revision>0.1.0-SNAPSHOT</revision>
        <spring.boot.version>4.1.0</spring.boot.version>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <testcontainers.version>2.0.5</testcontainers.version>
        <archunit.version>1.4.2</archunit.version>
        <webauthn4j.version>0.31.6.RELEASE</webauthn4j.version>
        <springdoc.version>3.1.0</springdoc.version>
        <maven.clean.plugin.version>3.5.0</maven.clean.plugin.version>
        <maven.install.plugin.version>3.1.4</maven.install.plugin.version>
        <maven.deploy.plugin.version>3.1.4</maven.deploy.plugin.version>
        <maven.enforcer.plugin.version>3.6.2</maven.enforcer.plugin.version>
        <maven.gpg.plugin.version>3.2.7</maven.gpg.plugin.version>
        <gpg.skip>false</gpg.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>dev.ainer</groupId>
                <artifactId>ainer-core</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>dev.ainer</groupId>
                <artifactId>ainer-spring</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>dev.ainer</groupId>
                <artifactId>ainer-starter-web</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>dev.ainer</groupId>
                <artifactId>ainer-starter-persistence</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>dev.ainer</groupId>
                <artifactId>ainer-security</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>dev.ainer</groupId>
                <artifactId>ainer-starter-security</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>dev.ainer</groupId>
                <artifactId>ainer-starter-cache</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>dev.ainer</groupId>
                <artifactId>ainer-starter-observability</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>dev.ainer</groupId>
                <artifactId>ainer-test-support</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>dev.ainer</groupId>
                <artifactId>ainer-module-identity</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>dev.ainer</groupId>
                <artifactId>ainer-module-workspace</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>dev.ainer</groupId>
                <artifactId>ainer-module-ai-runtime</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>dev.ainer</groupId>
                <artifactId>ainer-module-authorization</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>dev.ainer</groupId>
                <artifactId>ainer-module-dictionary</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>dev.ainer</groupId>
                <artifactId>ainer-module-config</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>dev.ainer</groupId>
                <artifactId>ainer-module-notification</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>dev.ainer</groupId>
                <artifactId>ainer-module-file</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>dev.ainer</groupId>
                <artifactId>ainer-module-organization</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>dev.ainer</groupId>
                <artifactId>ainer-module-knowledge</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>dev.ainer</groupId>
                <artifactId>ainer-module-task</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.ainer</groupId>
                <artifactId>ainer-initializer</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>dev.ainer</groupId>
                <artifactId>ainer-initializer-cli</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-junit-jupiter</artifactId>
                <version>${testcontainers.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-postgresql</artifactId>
                <version>${testcontainers.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit</artifactId>
                <version>${archunit.version}</version>
            </dependency>
            <dependency>
                <groupId>com.webauthn4j</groupId>
                <artifactId>webauthn4j-test</artifactId>
                <version>${webauthn4j.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <distributionManagement>
        <repository>
            <id>github-packages</id>
            <name>GitHub Packages (ainerlab/ainer-boot)</name>
            <url>https://maven.pkg.github.com/ainerlab/ainer-boot</url>
        </repository>
        <snapshotRepository>
            <id>github-packages</id>
            <name>GitHub Packages (ainerlab/ainer-boot)</name>
            <url>https://maven.pkg.github.com/ainerlab/ainer-boot</url>
        </snapshotRepository>
    </distributionManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>${maven.clean.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>${maven.install.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>${maven.deploy.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-gpg-plugin</artifactId>
                    <version>${maven.gpg.plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven.enforcer.plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-build-environment</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[25,26)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[4.0.0-rc-6,4.1.0)</version>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>sign-release-bom</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <skip>${gpg.skip}</skip>
                            <keyname>${gpg.keyname}</keyname>
                            <bestPractices>true</bestPractices>
                            <passphraseEnvName>MAVEN_GPG_PASSPHRASE</passphraseEnvName>
                            <useAgent>false</useAgent>
                            <gpgArguments>
                                <arg>--batch</arg>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
