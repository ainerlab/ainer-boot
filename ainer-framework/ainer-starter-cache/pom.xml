<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.ainer</groupId>
        <artifactId>ainer-framework</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>ainer-starter-cache</artifactId>
    <name>Ainer Starter Cache</name>
    <description>Cache and distributed coordination: Spring Cache abstraction with Caffeine (local) and Redis/Valkey (distributed) backends, plus distributed lock SPI (ADR-0039)</description>

    <dependencies>
        <dependency>
            <groupId>dev.ainer</groupId>
            <artifactId>ainer-core</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.ainer</groupId>
            <artifactId>ainer-spring</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context-support</artifactId>
        </dependency>

        <!-- Caffeine: default local cache backend (always available) -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- Redis: optional distributed backend — not forced on consumers -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
          Jackson 3（tools.jackson）是 GenericJacksonJsonRedisSerializer 的 JSON 绑定。
          Boot 4 基线自带该库（spring-boot-starter-jackson），这里声明为 optional：
          Redis 缓存后端要求它存在，但本地 Caffeine 后端不需要。
        -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers：PostgreSQL advisory lock 与 Redis 缓存/锁的真实后端验证 -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- advisory lock 集成测试需要真实 JDBC 驱动（仅测试作用域，生产不引入 JDBC starter） -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
