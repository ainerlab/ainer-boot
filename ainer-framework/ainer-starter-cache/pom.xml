<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.ainer</groupId>
        <artifactId>ainer-framework</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>ainer-starter-cache</artifactId>
    <name>Ainer Starter Cache</name>
    <description>Cache and distributed coordination: Spring Cache abstraction with Caffeine (local) and Redis/Valkey (distributed) backends, plus distributed lock SPI (ADR-0039)</description>

    <dependencies>
        <dependency>
            <groupId>dev.ainer</groupId>
            <artifactId>ainer-core</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.ainer</groupId>
            <artifactId>ainer-spring</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context-support</artifactId>
        </dependency>

        <!-- Caffeine: default local cache backend (always available) -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- Redis: optional distributed backend — not forced on consumers -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
