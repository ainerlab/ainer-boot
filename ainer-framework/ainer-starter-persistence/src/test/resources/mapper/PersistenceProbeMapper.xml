<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="dev.ainer.persistence.mybatisplus.PersistenceProbeMapper">
    <select id="selectNamesByScope" resultType="java.lang.String">
        SELECT name
        FROM ainer_persistence_probe
        WHERE scope_id = #{scopeId}
        ORDER BY name
    </select>
</mapper>
